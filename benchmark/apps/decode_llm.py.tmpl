"""An app that runs a standalone LLM task with prefix caching for decode profiling."""

from __future__ import annotations

from collections.abc import AsyncIterator

from cornserve.app.base import AppConfig
from cornserve_tasklib.task.unit.llm import (
    LLMUnitTask,
    OpenAIChatCompletionRequest,
    OpenAIChatCompletionChunk,
)

llm = LLMUnitTask(
    model_id="$MODEL_ID",
    receive_embeddings=$RECEIVE_EMBEDDINGS,
    enable_prefix_caching=True,
    tp_size=$TP_SIZE,
    max_num_seqs=$MAX_NUM_SEQS,
    gpu_memory_utilization=$GPU_MEMORY_UTILIZATION,
)


class Config(AppConfig):
    """App configuration model."""

    tasks = {"llm": llm}


async def serve(request: OpenAIChatCompletionRequest) -> AsyncIterator[OpenAIChatCompletionChunk]:
    """Main serve function for the app."""
    return await llm(request)
