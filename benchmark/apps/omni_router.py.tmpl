"""An app that routes Omni requests across multiple topologies."""

from __future__ import annotations

from collections.abc import AsyncIterator

from cornserve.app.base import AppConfig
from cornserve.task.base import Stream
from cornserve_tasklib.task.composite.omni import OmniMLLMTask, OmniTimeSharingMLLMTask, OmniInput
from cornserve_tasklib.task.composite.router import RouterApp
from cornserve_tasklib.task.unit.encoder import Modality
from cornserve_tasklib.task.unit.llm import OpenAIChatCompletionChunk

$ROUTE_DEFINITIONS

omni_router = RouterApp[OmniInput, Stream[OpenAIChatCompletionChunk]](
    routing_tasks=[$ROUTING_TASK_NAMES],
    routing_weights=[$ROUTING_WEIGHTS],
)


class Config(AppConfig):
    """App configuration model."""

    tasks = {"omni_router": omni_router}


async def serve(request: OmniInput) -> AsyncIterator[OpenAIChatCompletionChunk]:
    """Main serve function for the app."""
    return await omni_router(request)
